PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://sweety_user:sweety_local_password@localhost:5432/sweety_db
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173

# Email notifications (Gmail: use an App Password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sweetyglucotracker@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Glucose bandwidth for doctor alerts (mg/dL)
GLUCOSE_LOW=70
GLUCOSE_HIGH=180

# Minutes after a slot opens before a missing-reading reminder is emailed
REMINDER_GRACE_MINUTES=120
# How often the reminder job runs
REMINDER_INTERVAL_MINUTES=15
